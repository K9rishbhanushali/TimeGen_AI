# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MongoDB Atlas connection string. This is required for Vercel deployments.
# Create a database user in Atlas, then replace the placeholders below.
MONGODB_URI="mongodb+srv://hetfinavia24_db_user:HET@timegenai.v9r7tmg.mongodb.net/?appName=TimeGenAi"
DATABASE_NAME="TimeGenAi"

# Optional locally. Set to true outside Vercel when you also want to prevent
# fallback to the local JSON development store.
REQUIRE_MONGODB="false"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
